# Copie este arquivo para .env e ajuste os valores.
# Gere uma chave própria (a de exemplo é pública):
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Nome exibido na interface (fácil de trocar: Shopping Pulse, Circulaê, Nexora, Vibraê...)
NOME_PROJETO=Shopping Pulse

# Google Gemini — deixe vazio para usar o modo demonstração (análises prontas)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Reservas se o principal estiver sobrecarregado (separadas por vírgula)
GEMINI_MODELOS_RESERVA=gemini-3.5-flash-lite

# Opcional: endereço usado nos QR Codes de check-in (ex.: http://192.168.0.10:8000)
URL_PUBLICA=

# Administrador do painel: gere com `python manage.py definir_admin` (a senha é salva como hash)
ADMIN_USUARIO=
ADMIN_SENHA_HASH=

# Miro — exporta as recomendações da IA para um quadro (developers.miro.com → app com escopo boards:write).
# Sem token, o painel oferece um CSV para importar no Miro manualmente.
MIRO_ACCESS_TOKEN=
MIRO_BOARD_ID=
